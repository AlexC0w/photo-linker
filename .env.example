# PIN del panel de administrador
ADMIN_PIN=1234
# Puerto del servidor (Dokploy: puerto interno)
PORT=3000
# Carpeta de datos (SQLite + imágenes). En Docker usar /data con volumen montado.
DATA_DIR=./data

# Tiendas de Vently a las que se puede enviar (JSON en una sola línea).
# Cada tienda es un deploy distinto de Vently: su propia URL, usuario y base de datos.
# El usuario necesita permisos inventory.entries.create y inventory.product.edit.
# Si se deja vacío, la app funciona igual pero sin la opción de enviar (solo Excel).
# VENTLY_STORES=[{"id":"rml","name":"RML Store","url":"https://api.rml.mx","user":"linker","pass":"..."},{"id":"dosx1","name":"DOSX1","url":"https://api.dosx1.mx","user":"linker","pass":"..."}]
